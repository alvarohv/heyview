---
import { getCollection } from 'astro:content';
import type { GetStaticPaths } from 'astro';
import Layout from '../../../layouts/Layout.astro';
import Navbar from '../../../components/Navbar.astro';
import Footer from '../../../components/Footer.astro';
import BlogPost from '../../../components/BlogPost.astro';
import { blogSlug } from '../../../content.config';

export const getStaticPaths = (async () => {
  const posts = await getCollection(
    'blog',
    ({ data }) => !data.draft && data.lang === 'es',
  );
  return posts.map((post) => ({
    params: { slug: blogSlug(post.id) },
    props: { post },
  }));
}) satisfies GetStaticPaths;

const { post } = Astro.props;
const { title, description, cover } = post.data;
---

<Layout title={`${title}: HeyView`} description={description} image={cover} type="article">
  <div class="max-w-360 mx-auto relative shadow-sm">
    <Navbar transition:persist />
    <BlogPost post={post} />
    <Footer />
  </div>
</Layout>
