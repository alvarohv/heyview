---
const problemBody = `CoolBrand CR es una boutique de consignación de lujo en Costa Rica: relojes de colección, joyería fina, bolsos premium, artículos que pueden valer decenas de miles de dólares. Su sitio en Shopify tenía tráfico orgánico constante. Lo que no tenía era una sola consulta. El diseño se sentía genérico: visualmente desalineado con el posicionamiento de lujo que buscaba la marca, un layout desordenado con estructura de categorías inconsistente, y un flujo de checkout estándar que no tenía sentido para artículos de alto valor donde los clientes quieren hablar antes de comprometerse. Tráfico sin conversión es un problema de diseño, no de SEO.`;

const solutionIntro = "El rediseño partió de un solo insight: para consignación de lujo, el carrito de compras es la interfaz equivocada. Los clientes necesitan preguntar sobre condición, procedencia y precio antes de comprometerse. Cada decisión de layout, desde la estética hasta la ruta de conversión, se derivó de ahí.";

const solutionFeatures = [
  {
    title: "Una estética editorial oscura",
    body: "Fondos oscuros, tipografía en acento dorado, imágenes de héroe de alto contraste: un layout que se lee como una revista de coleccionistas, no una tienda de commodities. Elegido para transmitir exclusividad y autoridad de marca, no solo estilo."
  },
  {
    title: "WhatsApp como el CTA principal",
    body: "Un botón flotante de WhatsApp persistente en cada página, más un CTA de consulta por producto por encima de cualquier opción de carrito. Un clic de navegar a conversación, sin importar en qué parte del sitio esté el cliente."
  },
  {
    title: "Una arquitectura que refleja el negocio",
    body: "Nueva jerarquía de secciones que coincide con cómo compran realmente los clientes de CoolBrand y cómo funciona realmente el negocio: puntos de entrada editoriales a la colección, intake de consignación visible de forma prominente, y captura de consultas para clientes buscando piezas específicas."
  }
];
---

<!-- THE CONTEXT -->
<section class="bg-surface text-primary" style="border-top: 0.5px solid #E7E1D6; border-bottom: 0.5px solid #E7E1D6;">
  <div class="max-w-360 mx-auto px-5 md:px-16 py-20 md:py-28 grid grid-cols-1 md:grid-cols-12 gap-6 md:gap-10">
    <div class="md:col-span-4">
      <h2 class="font-serif text-[32px] md:text-[40px] text-primary font-normal leading-tight">
        El Contexto
      </h2>
    </div>
    <div class="md:col-span-7 md:col-start-6">
      <p class="font-sans text-[17px] md:text-[20px] leading-relaxed text-secondary max-w-2xl">
        {problemBody}
      </p>
    </div>
  </div>
</section>

<!-- THE SOLUTION -->
<section class="bg-navy" style="color: #F5F0E8;">
  <div class="max-w-360 mx-auto px-5 md:px-16 py-20 md:py-28 grid grid-cols-1 md:grid-cols-12 gap-6 md:gap-10">
    <div class="md:col-span-5">
      <h2 class="font-serif text-[32px] md:text-[40px] text-cream font-normal leading-tight mb-6">
        La Solución
      </h2>
      <p class="font-sans text-[17px] md:text-[20px] leading-relaxed" style="color: rgba(245,240,232,0.65);">
        {solutionIntro}
      </p>
    </div>

    <div class="md:col-span-6 md:col-start-7 space-y-12">
      {solutionFeatures.map((feature, idx) => (
        <div class="group relative pl-12">
          <div class="absolute left-0 top-2 w-4 h-4 rounded-full" style="background-color: #A67C52;"></div>
          {idx < solutionFeatures.length - 1 && (
            <div class="absolute left-2 top-6 w-[0.5px] h-full" style="background-color: rgba(245,240,232,0.1);"></div>
          )}
          <h3 class="font-serif text-[22px] text-cream mb-3 font-normal leading-snug">
            {feature.title}
          </h3>
          <p class="font-sans text-[15px] leading-relaxed" style="color: rgba(245,240,232,0.65);">
            {feature.body}
          </p>
        </div>
      ))}
    </div>
  </div>
</section>
