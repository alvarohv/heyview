---
import { getCollection } from 'astro:content';
import WorkCard from './WorkCard.astro';
import { useTranslations, getRelativeLocaleUrl } from '../i18n/utils';

const locale = Astro.currentLocale === 'es' ? 'es' : 'en';

// Single source of truth: projects live in src/content/work/*.md.
const projects = (
  await getCollection('work', ({ data }) => !data.draft && data.lang === locale)
).sort((a, b) => a.data.order - b.data.order);

const featured = projects.find((p) => p.data.featured) ?? projects[0];
const sideProjects = projects.filter((p) => p.id !== featured?.id).slice(0, 2);

const t = useTranslations(locale).caseStudies;
---

<section id="work" class="bg-navy px-5 md:px-16 py-24">

  <div class="flex justify-between items-end mb-16">
    <div>
      <span class="eyebrow text-accent-green block mb-6">{t.eyebrow}</span>
      <h2 class="font-serif text-[32px] md:text-[40px] text-cream font-normal">{t.headline}</h2>
    </div>
    <a href={getRelativeLocaleUrl(locale, '/work')} class="group inline-flex items-center gap-2 font-sans text-[13px] font-semibold tracking-widest uppercase text-muted-soft hover:text-cream transition-colors duration-200 whitespace-nowrap">
      <span class="underline-offset-4 group-hover:underline">{t.viewAll}</span>
      <span
        class="material-symbols-outlined translate-x-0 group-hover:translate-x-1.5 transition-transform duration-300"
        style="font-size: 17px; font-variation-settings: 'FILL' 0, 'wght' 300, 'GRAD' 0, 'opsz' 20;"
      >arrow_forward</span>
    </a>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-12 gap-6">

    <!-- Featured project — 8 cols -->
    {featured && <WorkCard project={featured} variant="featured" class="col-span-1 md:col-span-8" />}

    <!-- Side projects — 4 cols -->
    <div class="col-span-1 md:col-span-4 flex flex-col gap-6">
      {sideProjects.map((project) => <WorkCard project={project} variant="compact" class="flex-1" />)}
    </div>

  </div>

</section>
